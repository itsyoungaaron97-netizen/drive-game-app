{
  "expo": {
    "name": "DriveGame",
    "slug": "drive-game",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.drivegame.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndInUsePermission": "Allow DriveGame to track your drives."
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "59532c97-efe3-4cda-8d81-44e3aa5d3d0e"
      }
    },
    "ios": {
      "bundleIdentifier": "com.drivegame.app"
    }
  }
}
